rules_version = '2';

// Exera Cargo — multi-tenant Firestore rules. Push notifications use Cloud Functions (Admin SDK bypasses rules).
// Public visitors may only: read tenant configs/domains, create validated bookings,
// tracking records and contact messages, and get a single tracking doc by ref.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }
    function isAdmin() {
      return signedIn() && exists(adminPath());
    }
    // active driver of tenant t (driver doc id == auth uid)
    // external (one-time link) drivers lose access when their link expires
    function isDriver(t) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(t)/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(t)/drivers/$(request.auth.uid)).data.active == true
        && (get(/databases/$(database)/documents/tenants/$(t)/drivers/$(request.auth.uid)).data.get('external', false) == false
            || get(/databases/$(database)/documents/tenants/$(t)/drivers/$(request.auth.uid)).data.expiresAt > request.time.toMillis());
    }
    // company driver (not a one-time-link driver): fleet list, broadcast chat, fuel log
    function isInternalDriver(t) {
      return isDriver(t)
        && get(/databases/$(database)/documents/tenants/$(t)/drivers/$(request.auth.uid)).data.get('external', false) == false;
    }
    // one-time link, as it will be after the current write/batch
    function linkAfter(token) {
      return getAfter(/databases/$(database)/documents/jobLinks/$(token)).data;
    }
    function claimedByMe(t, token) {
      let l = linkAfter(token);
      return l.tenantId == t && l.status == 'claimed' && l.claimedBy == request.auth.uid && request.time.toMillis() < l.expiresAt;
    }
    // driver doc an external driver may write for themself when claiming a link
    // prevExp: the expiry the phone already had from an earlier link (kept when it is later)
    function validExtDriver(t, prevExp) {
      let d = request.resource.data;
      return d.external == true && d.active == true && d.loginId == 'link'
        && d.linkToken is string && claimedByMe(t, d.linkToken)
        && (d.expiresAt == linkAfter(d.linkToken).expiresAt
            || (prevExp > linkAfter(d.linkToken).expiresAt && d.expiresAt == prevExp))
        && str(d.name, 1, 120)
        && d.status in ['off_duty', 'available', 'on_job']
        && d.keys().hasOnly(['name', 'phone', 'status', 'active', 'ownership', 'transporterId', 'transporterName', 'external',
                             'linkToken', 'expiresAt', 'loginId', 'createdAt', 'updatedAt']);
    }
    // the only status moves a driver may make: one step forward, or 'failed' from an open step
    // (multi-stop jobs loop between pickups and deliveries)
    function driverStep(from, to) {
      return (from == 'assigned' && to == 'accepted')
        || (from == 'accepted' && to == 'started')
        || (from == 'started' && to in ['at_pickup', 'in_transit'])
        || (from == 'at_pickup' && to == 'loaded')
        || (from == 'loaded' && to in ['in_transit', 'at_pickup'])
        || (from == 'in_transit' && to in ['at_pickup', 'at_delivery'])
        || (from == 'at_delivery' && to in ['delivered', 'in_transit'])
        || (from == 'delivered' && to == 'completed')
        || (to == 'failed' && from in ['assigned', 'accepted', 'started', 'at_pickup', 'loaded', 'in_transit', 'at_delivery']);
    }
    function driverOfJob(t, jobId) {
      return isDriver(t)
        && get(/databases/$(database)/documents/tenants/$(t)/jobs/$(jobId)).data.driverId == request.auth.uid;
    }

    function isSuper() {
      return isAdmin() && get(adminPath()).data.role == 'super';
    }
    function canManage(t) {
      return isSuper()
        || (isAdmin()
            && get(adminPath()).data.tenants is list
            && (t in get(adminPath()).data.tenants || '*' in get(adminPath()).data.tenants));
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function optStr(m, k, max) {
      return !(k in m) || str(m[k], 0, max);
    }
    function num(v, min, max) {
      return v is number && v >= min && v <= max;
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isTime(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function isRef(v) {
      return v is string && v.matches('^[A-Z]{1,3}-[A-Z0-9]{7}$');
    }
    // Public writes are only accepted for tenants that have been published (Admin → Save & publish).
    function tenantExists(t) {
      return exists(/databases/$(database)/documents/tenants/$(t));
    }
    function statuses() {
      return ['pending', 'confirmed', 'assigned', 'in_transit', 'completed', 'cancelled'];
    }

    // ── admins ─────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow write: if isSuper();
    }

    // ── tenants (public config) ────────────────────────────
    match /tenants/{t} {
      allow get: if true;
      allow list: if isSuper();
      allow create, update: if canManage(t) && request.resource.data.id == t;
      allow delete: if isSuper();

      // bookings: PII — public create only, admin read/manage
      match /bookings/{id} {
        // doc id == booking ref so tracking create can prove a booking exists
        allow create: if tenantExists(t) && id == request.resource.data.ref && validBooking(request.resource.data, t);
        allow read, delete: if canManage(t);
        allow update: if (canManage(t) || driverOfJob(t, id))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(canManage(t) ? ['status', 'adminNote', 'updatedAt'] : ['status', 'updatedAt'])
          && request.resource.data.status in statuses()
          && (!('adminNote' in request.resource.data) || str(request.resource.data.adminNote, 0, 1000))
          && request.resource.data.updatedAt is int;
      }

      // tracking: PII-free; get by exact ref only (no listing)
      match /tracking/{ref} {
        allow get: if true;
        allow list: if canManage(t);
        allow create: if validTracking(request.resource.data, ref)
          && existsAfter(/databases/$(database)/documents/tenants/$(t)/bookings/$(ref))
          && !exists(/databases/$(database)/documents/tenants/$(t)/bookings/$(ref));
        allow update, delete: if canManage(t);
        // the assigned driver's app keeps the customer's tracking status in step with the job
        allow update: if driverOfJob(t, ref)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'note'])
          && request.resource.data.status in statuses()
          && (!('note' in request.resource.data) || str(request.resource.data.note, 0, 300));
      }

      // contact messages
      match /messages/{id} {
        allow create: if tenantExists(t) && validMessage(request.resource.data);
        allow read, delete: if canManage(t);
      }

      // ══ Operations: dispatch console (managers) + driver app (drivers) ══

      match /vehicles/{vid} {
        allow read: if canManage(t) || isInternalDriver(t);
        allow create, delete: if canManage(t);
        allow update: if canManage(t)
          || (isDriver(t)
              // only the vehicle on a job this driver is assigned to (job id passed as lastJobId)
              && request.resource.data.lastJobId is string
              && get(/databases/$(database)/documents/tenants/$(t)/jobs/$(request.resource.data.lastJobId)).data.driverId == request.auth.uid
              && get(/databases/$(database)/documents/tenants/$(t)/jobs/$(request.resource.data.lastJobId)).data.vehicleId == vid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['odometerKm', 'status', 'updatedAt', 'lastJobId'])
              && request.resource.data.odometerKm is number
              && request.resource.data.odometerKm >= resource.data.get('odometerKm', 0)
              && request.resource.data.odometerKm <= resource.data.get('odometerKm', 0) + 5000
              && request.resource.data.status in ['available', 'on_job']);
      }

      match /drivers/{uid} {
        allow read: if canManage(t) || (signedIn() && request.auth.uid == uid);
        allow delete: if canManage(t);
        allow create: if canManage(t) || (signedIn() && request.auth.uid == uid && validExtDriver(t, 0));
        allow update: if canManage(t)
          || (signedIn() && request.auth.uid == uid && resource.data.active == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && request.resource.data.status in ['off_duty', 'available', 'on_job'])
          // the same phone opening another link (still an external driver)
          || (signedIn() && request.auth.uid == uid && resource.data.get('external', false) == true
              && validExtDriver(t, resource.data.get('expiresAt', 0)));
      }

      match /jobs/{jobId} {
        allow read: if canManage(t) || (isDriver(t) && resource.data.driverId == request.auth.uid);
        allow create, delete: if canManage(t);
        allow update: if canManage(t)
          // external driver claiming a one-time link: placeholder driver → their anonymous uid
          || (signedIn()
              && resource.data.get('extLink', null) != null
              && resource.data.driverId == 'link:' + resource.data.extLink.token
              && claimedByMe(t, resource.data.extLink.token)
              && jobId in linkAfter(resource.data.extLink.token).jobIds
              && request.resource.data.driverId == request.auth.uid
              && request.resource.data.extLink.token == resource.data.extLink.token
              && request.resource.data.extLink.status == 'claimed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverId', 'driverName', 'extLink', 'updatedAt']))
          || (isDriver(t)
              && resource.data.driverId == request.auth.uid
              && request.resource.data.driverId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'stops', 'pins', 'odoStart', 'odoEnd', 'actualKm', 'inspection', 'pod', 'failReason', 'updatedAt', 'lastEventAt'])
              // GPS spots captured on "Arrived" (one per stop)
              && (!('pins' in request.resource.data) || (request.resource.data.pins is map && request.resource.data.pins.size() <= 32))
              && (!('stops' in request.resource.data) || (request.resource.data.stops is list && request.resource.data.stops.size() <= 30))
              && driverStep(resource.data.status, request.resource.data.status)
              // start reading is fixed once captured; end ≥ start and within a sane trip length
              && (!('odoStart' in resource.data) || request.resource.data.odoStart == resource.data.odoStart)
              && (!('odoEnd' in request.resource.data) || !('odoStart' in request.resource.data)
                  || (request.resource.data.odoEnd.km is number
                      && request.resource.data.odoEnd.km >= request.resource.data.odoStart.km
                      && request.resource.data.odoEnd.km <= request.resource.data.odoStart.km + 5000))
              && (!('actualKm' in request.resource.data)
                  || (request.resource.data.actualKm is number && request.resource.data.actualKm >= 0 && request.resource.data.actualKm <= 5000))
              && (!('failReason' in request.resource.data) || str(request.resource.data.failReason, 0, 300))
              && (!('pod' in request.resource.data) || request.resource.data.pod.size() <= 12)
              && (!('inspection' in request.resource.data) || request.resource.data.inspection.size() <= 12));

        match /events/{eid} {
          allow read: if canManage(t) || driverOfJob(t, jobId);
          allow create: if (canManage(t) || driverOfJob(t, jobId))
            && request.resource.data.by == request.auth.uid
            && str(request.resource.data.byName, 1, 120)
            && (!('note' in request.resource.data) || str(request.resource.data.note, 0, 1000));
          allow update, delete: if false; // append-only audit trail
        }
      }

      // photos / signatures stored inline (no Cloud Storage on Spark)
      match /media/{mid} {
        allow read: if canManage(t)
          || (isDriver(t)
              && (resource.data.by == request.auth.uid
                  // chat photos only from the driver's own thread or the broadcast channel
                  || (resource.data.kind == 'chat' && resource.data.get('threadId', '') == request.auth.uid)
                  || (resource.data.kind == 'chat' && resource.data.get('threadId', '') == 'broadcast' && isInternalDriver(t))
                  // photos of a job currently assigned to this driver
                  || (resource.data.get('jobId', '') != '' && driverOfJob(t, resource.data.jobId))));
        allow create: if (canManage(t) || isDriver(t))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 900000
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.kind in ['odo_start', 'odo_end', 'fuel_odo', 'pod_photo', 'signature', 'inspection', 'load', 'damage', 'receipt', 'chat']
          && (request.resource.data.kind != 'chat' || canManage(t) || request.resource.data.get('threadId', '') == request.auth.uid);
        allow update: if false;
        allow delete: if canManage(t);
      }

      // chat: thread id == driver uid, or 'broadcast'
      match /threads/{th} {
        allow read: if canManage(t) || (isDriver(t) && th == request.auth.uid) || (th == 'broadcast' && isInternalDriver(t));
        allow write: if canManage(t)
          || (isDriver(t) && th == request.auth.uid
              && request.resource.data.keys().hasOnly(['driverId', 'driverName', 'lastText', 'lastAt', 'lastFrom', 'unreadOps', 'unreadDriver']));

        match /messages/{mid} {
          allow read: if canManage(t) || (isDriver(t) && th == request.auth.uid) || (th == 'broadcast' && isInternalDriver(t));
          allow create: if request.resource.data.from == request.auth.uid
            && str(request.resource.data.text, 0, 2000)
            && (canManage(t) || (isDriver(t) && th == request.auth.uid && request.resource.data.role == 'driver'));
          allow update, delete: if canManage(t);
        }
      }

      // click-wrap acceptance records (Terms / Privacy / Driver licence): append-only audit trail.
      // id = "<uid>_<docId>_<version>" so a user can check their own records (even missing ones) without listing.
      match /acceptances/{id} {
        allow get: if signedIn() && id.matches(request.auth.uid + '_.*');
        allow list: if canManage(t);
        allow create: if signedIn() && tenantExists(t)
          && request.resource.data.uid == request.auth.uid
          && id == request.auth.uid + '_' + request.resource.data.docId + '_' + request.resource.data.version
          && request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'docId', 'version', 'acceptedAt', 'userAgent', 'appVersion', 'method'])
          && request.resource.data.role in ['ops', 'driver', 'hired']
          && request.resource.data.docId in ['terms', 'privacy', 'driver', 'hired', 'booking', 'transporter']
          && str(request.resource.data.version, 8, 20)
          && str(request.resource.data.name, 0, 120)
          && str(request.resource.data.userAgent, 0, 300)
          && str(request.resource.data.appVersion, 0, 40)
          && request.resource.data.method == 'clickwrap'
          && request.resource.data.acceptedAt == request.time;
        allow update, delete: if false;
      }

      // ── dispatch-only commercial data ──
      match /transporters/{id} {
        allow read, write: if canManage(t);
      }
      match /finance/{jobId} {
        allow read, write: if canManage(t);
      }
      // customer address book (saved exact locations)
      match /places/{id} {
        allow read, write: if canManage(t);
      }
      match /settlements/{id} {
        allow read, create: if canManage(t);
        // paid statements are final
        allow update, delete: if canManage(t) && resource.data.status != 'paid';
      }

      // push tokens: doc id = "<uid>__<installId>"; only Cloud Functions read them all
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || canManage(t));
        allow create, update: if signedIn()
          && deviceId.matches(request.auth.uid + '__[A-Za-z0-9_-]{6,64}')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tenantId == t
          && ((request.resource.data.role == 'ops' && canManage(t)) || (request.resource.data.role == 'driver' && isDriver(t)))
          && request.resource.data.platform in ['android', 'ios', 'web']
          && str(request.resource.data.token, 20, 4096)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'token', 'platform', 'tenantId', 'updatedAt']);
      }

      match /locations/{uid} {
        allow read: if canManage(t);
        allow delete: if canManage(t) || (signedIn() && request.auth.uid == uid);
        allow create, update: if isDriver(t) && request.auth.uid == uid
          && request.resource.data.driverId == uid
          && request.resource.data.lat is number && request.resource.data.lng is number;
      }

      match /fuel/{fid} {
        allow read: if canManage(t) || (isInternalDriver(t) && resource.data.driverId == request.auth.uid);
        allow create: if canManage(t) || (isInternalDriver(t) && request.resource.data.driverId == request.auth.uid
          && request.resource.data.litres is number && request.resource.data.litres > 0 && request.resource.data.litres <= 2000);
        allow update, delete: if canManage(t);
      }
    }

    // one-time job links: the 32-char token is the secret, so single gets are public
    match /jobLinks/{token} {
      allow get: if true;
      allow list: if signedIn() && canManage(resource.data.tenantId);
      allow create: if canManage(request.resource.data.tenantId)
        && token.size() >= 24
        && request.resource.data.token == token
        && request.resource.data.status == 'open'
        && request.resource.data.jobIds is list && request.resource.data.jobIds.size() >= 1 && request.resource.data.jobIds.size() <= 20;
      allow update: if canManage(resource.data.tenantId)
        || (signedIn()
            && resource.data.status == 'open'
            && request.time.toMillis() < resource.data.expiresAt
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt']));
      allow delete: if canManage(resource.data.tenantId);
    }

    // driver uid → tenant (written by managers when creating a login)
    match /driverIndex/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if canManage(request.resource.data.tenantId);
      allow delete: if isSuper();
    }

    // ── domain → tenant map ────────────────────────────────
    match /domains/{host} {
      allow read: if true;
      // Only platform super admins map hostnames — prevents tenants hijacking each other's domains.
      allow create, update: if isSuper()
        && request.resource.data.keys().hasOnly(['tenantId'])
        && request.resource.data.tenantId is string;
      allow delete: if isSuper();
    }

    // ── validators ─────────────────────────────────────────
    function validBooking(d, t) {
      return d.keys().hasAll(['tenantId', 'kind', 'customer', 'vehicleId', 'vehicleName', 'loadType', 'pickup', 'dropoff',
                              'date', 'time', 'distanceKm', 'trips', 'quote', 'lang', 'ref', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['tenantId', 'kind', 'customer', 'vehicleId', 'vehicleName', 'serviceId', 'loadType', 'pickup', 'dropoff',
                             'recipient', 'freight', 'rfq', 'date', 'time', 'distanceKm', 'trips', 'notes', 'promoCode', 'quote', 'lang',
                             'ref', 'status', 'createdAt', 'updatedAt', 'serverCreatedAt', 'termsVersion', 'termsAcceptedAt'])
        && d.tenantId == t
        && d.kind in ['vehicle', 'freight']
        && d.status == 'pending'
        && isRef(d.ref)
        && validCustomer(d.customer)
        && ((d.kind == 'freight' && d.freight['service'] in ['ltl', 'courier']) ? str(d.vehicleId, 0, 60) : str(d.vehicleId, 1, 60))
        && str(d.vehicleName, 1, 100)
        && optStr(d, 'serviceId', 60)
        && str(d.loadType, 1, 60)
        && validStop(d.pickup)
        && validStop(d.dropoff)
        && (!('recipient' in d) || validRecipient(d.recipient))
        && (d.kind == 'freight' ? ('freight' in d && validFreight(d.freight) && 'recipient' in d) : !('freight' in d))
        && (!('rfq' in d) || d.rfq is bool)
        && isDate(d.date)
        && isTime(d.time)
        && num(d.distanceKm, 0, 4000)
        && d.trips is int && d.trips >= 1 && d.trips <= 50
        && optStr(d, 'notes', 1000)
        && optStr(d, 'promoCode', 30)
        && validQuote(d.quote)
        && d.lang in ['en', 'si', 'ta', 'af', 'zu']
        && d.createdAt is int
        && d.updatedAt is int
        && (!('serverCreatedAt' in d) || d.serverCreatedAt == request.time)
        && optStr(d, 'termsVersion', 40)
        && (!('termsAcceptedAt' in d) || d.termsAcceptedAt is int);
    }

    function validCustomer(c) {
      return c is map
        && c.keys().hasAll(['name', 'phone'])
        && c.keys().hasOnly(['name', 'phone', 'email', 'company', 'vatNo', 'poNumber'])
        && str(c.name, 2, 80)
        && str(c.phone, 9, 20)
        && optStr(c, 'email', 120)
        && optStr(c, 'company', 120)
        && optStr(c, 'vatNo', 30)
        && optStr(c, 'poNumber', 40);
    }

    function validRecipient(r) {
      return r is map
        && r.keys().hasAll(['name', 'phone'])
        && r.keys().hasOnly(['name', 'phone'])
        && str(r.name, 2, 80)
        && str(r.phone, 8, 20);
    }

    // Town-level stop: placeId from the bundled geo dataset, denormalised town + region names.
    function validStop(p) {
      return p is map
        && p.keys().hasAll(['address', 'placeId', 'place', 'region'])
        && p.keys().hasOnly(['address', 'placeId', 'place', 'region'])
        && str(p.address, 1, 200)
        && str(p.placeId, 1, 60)
        && str(p.place, 1, 80)
        && str(p.region, 1, 60);
    }

    function validFreight(f) {
      return f is map
        && f.keys().hasAll(['service', 'level', 'packages', 'pallets', 'weightKg', 'lengthCm', 'widthCm', 'heightCm',
                            'description', 'declaredValue', 'insured', 'hazardous', 'tailLift', 'helpers', 'afterHours'])
        && f.keys().hasOnly(['service', 'level', 'packages', 'pallets', 'weightKg', 'lengthCm', 'widthCm', 'heightCm',
                             'description', 'declaredValue', 'insured', 'hazardous', 'tailLift', 'helpers', 'afterHours', 'crossBorder'])
        && f['service'] in ['ftl', 'ltl', 'courier', 'removals']
        && f.level in ['economy', 'express', 'sameday']
        && num(f.packages, 0, 500)
        && num(f.pallets, 0, 40)
        && num(f.weightKg, 0, 40000)
        && num(f.lengthCm, 0, 1500)
        && num(f.widthCm, 0, 1500)
        && num(f.heightCm, 0, 1500)
        && str(f.description, 1, 300)
        && num(f.declaredValue, 0, 100000000)
        && f.insured is bool
        && f.hazardous == false
        && f.tailLift is bool
        && num(f.helpers, 0, 10)
        && f.afterHours is bool
        && (!('crossBorder' in f) || validCrossBorder(f.crossBorder));
    }

    function validCrossBorder(c) {
      return c is map
        && c.keys().hasAll(['country', 'borderPostId', 'borderPostName', 'delayHrs'])
        && c.keys().hasOnly(['country', 'borderPostId', 'borderPostName', 'delayHrs'])
        && c.country in ['LS', 'SZ', 'BW', 'NA', 'ZW', 'MZ', 'ZM']
        && str(c.borderPostId, 1, 60)
        && str(c.borderPostName, 1, 80)
        && num(c.delayHrs, 0, 200);
    }

    function validQuote(q) {
      return q is map
        && q.keys().hasAll(['base', 'distance', 'returnLeg', 'addOns', 'border', 'subtotal', 'discount', 'tax', 'total', 'currency', 'lines'])
        && q.keys().hasOnly(['base', 'distance', 'returnLeg', 'addOns', 'border', 'subtotal', 'discount', 'tax', 'total', 'currency', 'lines'])
        && num(q.base, 0, 50000000)
        && num(q.distance, 0, 50000000)
        && num(q.returnLeg, 0, 50000000)
        && num(q.addOns, 0, 50000000)
        && num(q.border, 0, 50000000)
        && num(q.subtotal, 0, 50000000)
        && num(q.discount, 0, 50000000)
        && num(q.tax, 0, 50000000)
        && num(q.total, 0, 50000000)
        && q.currency in ['LKR', 'ZAR']
        && q.lines is list && q.lines.size() <= 20;
    }

    function validTracking(d, ref) {
      return d.keys().hasAll(['ref', 'status', 'date', 'time', 'vehicleName', 'kind', 'pickupPlace', 'dropoffPlace', 'updatedAt'])
        && d.keys().hasOnly(['ref', 'status', 'date', 'time', 'vehicleName', 'kind', 'pickupPlace', 'dropoffPlace', 'updatedAt', 'note'])
        && d.ref == ref
        && isRef(ref)
        && d.status == 'pending'
        && isDate(d.date)
        && isTime(d.time)
        && str(d.vehicleName, 1, 100)
        && d.kind in ['vehicle', 'freight']
        && str(d.pickupPlace, 1, 80)
        && str(d.dropoffPlace, 1, 80)
        && d.updatedAt is int
        && !('note' in d);
    }

    function validMessage(m) {
      return m.keys().hasAll(['name', 'phone', 'message'])
        && m.keys().hasOnly(['name', 'phone', 'email', 'message', 'createdAt'])
        && str(m.name, 1, 80)
        && str(m.phone, 5, 20)
        && optStr(m, 'email', 120)
        && str(m.message, 1, 2000)
        && (!('createdAt' in m) || m.createdAt is int);
    }

    // ── everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
