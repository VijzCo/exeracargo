# Copy to .env.local and fill from Firebase console → Project settings → Your apps → Web app.
# Leave empty to run in local DEMO mode (localStorage, admin password: demo1234).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tenant used when no ?site=, domain mapping or subdomain match is found.
VITE_DEFAULT_TENANT=kopano

# 'browser' (default, Firebase Hosting) or 'hash' (static hosts without rewrites)
VITE_ROUTER=browser

# Extra operator hosts where ?site=<id> may switch tenants (comma-separated). '*' = everywhere (demo builds only).
VITE_PLATFORM_HOSTS=

# Optional App Check (reCAPTCHA v3 site key) — strongly recommended in production.
VITE_APPCHECK_SITE_KEY=
