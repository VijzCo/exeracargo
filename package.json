{
  "name": "exeracargo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 4173",
    "deploy": "npm run build && firebase deploy",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "deploy:spark": "npm run build && firebase deploy --only hosting,firestore",
    "build:android": "node scripts/build-android.mjs",
    "android:open": "cap open android",
    "android:run": "npm run build:android && cap run android",
    "android:assets": "node scripts/android-assets.mjs",
    "assetlinks": "node scripts/assetlinks.mjs",
    "functions:deploy": "npm --prefix functions install && firebase deploy --only functions"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^7.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "1.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
